# Audiotool Nexus connector — env.
# Register the app at https://developer.audiotool.com/applications first.
#
# Two kinds of vars:
#   VITE_*       → PUBLIC, inlined into the browser bundle. Only safe values.
#   (un-prefixed)→ SERVER-only, used by the proxy (api/autopilot + vite dev
#                  middleware). NEVER exposed to the browser. Secrets go here.

# ---- PUBLIC (browser) -------------------------------------------------------

# OAuth public client id (PKCE — no client secret). Safe to expose.
VITE_AUDIOTOOL_CLIENT_ID=

# Must EXACTLY match a redirect URI registered for the app (trailing slash incl.).
#   Local dev:  http://127.0.0.1:5173/   (Audiotool rejects "localhost" — use 127.0.0.1)
#   Production: https://connector.sigmora.org/   (set in Vercel; register on the
#               Audiotool app; flip the app to Production)
VITE_AUDIOTOOL_REDIRECT_URI=http://127.0.0.1:5173/

# ---- SERVER-only (proxy) ----------------------------------------------------
# The browser calls same-origin /api/autopilot/*; the proxy verifies the user's
# Audiotool session (GetWhoami) and attaches the key below before forwarding.

# Public base URL of the deployed content-autopilot service.
AUTOPILOT_URL=http://localhost:3000

# Shared service secret — must equal content-autopilot's COMPUTE_API_KEY.
# Setting it also enables "production posture": a valid Audiotool session is
# then required on every call. Leave EMPTY for local dev (backend allow-all).
COMPUTE_API_KEY=

# Optional: Sigmora pre-save minter (apps/web POST /api/presave → createStripePaymentLink).
# When set, the release "support" CTA mints a real Stripe link; else the offer
# is just displayed. e.g. https://www.sigmora.org/api/presave
PRESAVE_URL=
