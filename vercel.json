{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "ignoreCommand": "npx turbo-ignore audiotool-connector",
  "rewrites": [
    { "source": "/api/autopilot/(.*)", "destination": "/api/autopilot/[...path]" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
